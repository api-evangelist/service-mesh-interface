{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-evangelist.github.io/service-mesh-interface/json-schema/tcp-route-schema.json",
  "title": "SMI TCPRoute",
  "description": "Service Mesh Interface (SMI) TCPRoute resource (specs.smi-spec.io/v1alpha4). Matches TCP traffic by destination port. Source: https://github.com/servicemeshinterface/smi-spec/blob/main/apis/traffic-specs/v1alpha4/traffic-specs.md",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "specs.smi-spec.io/v1alpha4" },
    "kind": { "const": "TCPRoute" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["matches"],
      "properties": {
        "matches": {
          "type": "object",
          "required": ["ports"],
          "properties": {
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    }
  }
}
